@namespace BlazeMd2Pdf.Controls

@using Microsoft.JSInterop
@using MudBlazor

@implements IDisposable

<div @ref="_host" class="blaze-markdown-html-source" style="position:absolute;left:-100000px;top:0;width:800px;visibility:hidden;pointer-events:none;">
    <MudMarkdown Value="@_markdown" />
</div>

@code {
    /// <summary>Provides JavaScript interop for reading the rendered MudMarkdown HTML.</summary>
    [Inject]
    private IJSRuntime JsRuntime { get; set; } = default!;

    /// <summary>References the host element containing the MudMarkdown component.</summary>
    private ElementReference _host;

    /// <summary>Stores the Markdown value rendered by MudMarkdown.</summary>
    private string _markdown = string.Empty;

    /// <summary>Stores the pending HTML capture operation.</summary>
    private TaskCompletionSource<string>? _pendingRequest;

    /// <summary>Indicates whether the component has been disposed.</summary>
    private bool _disposed;

    /// <summary>Extracts the HTML produced by MudMarkdown after the browser has completed the render.</summary>
    /// <param name="markdown">The Markdown source to render.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    /// <returns>The rendered HTML contained by the component.</returns>
    public async Task<string> RenderHtmlAsync(string markdown, CancellationToken cancellationToken = default)
    {
        ArgumentNullException.ThrowIfNull(markdown);
        ObjectDisposedException.ThrowIf(_disposed, this);
        cancellationToken.ThrowIfCancellationRequested();

        _pendingRequest?.TrySetCanceled();
        var request = new TaskCompletionSource<string>(TaskCreationOptions.RunContinuationsAsynchronously);
        _pendingRequest = request;
        _markdown = markdown;

        using var registration = cancellationToken.Register(static state =>
        {
            ((TaskCompletionSource<string>)state!).TrySetCanceled();
        }, request);

        await InvokeAsync(StateHasChanged);
        return await request.Task;
    }

    /// <summary>Captures the rendered MudMarkdown DOM after Blazor has completed the render pass.</summary>
    /// <param name="firstRender">Whether this is the first render.</param>
    /// <returns>A task representing the asynchronous operation.</returns>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var request = _pendingRequest;
        if (request is null || _disposed)
        {
            return;
        }

        try
        {
            var html = await JsRuntime.InvokeAsync<string>("blazeMd2Pdf.getInnerHtml", _host);
            if (ReferenceEquals(_pendingRequest, request))
            {
                _pendingRequest = null;
                request.TrySetResult(html ?? string.Empty);
            }
        }
        catch (Exception exception)
        {
            if (ReferenceEquals(_pendingRequest, request))
            {
                _pendingRequest = null;
                request.TrySetException(exception);
            }
        }
    }

    /// <summary>Releases resources and completes any pending capture operation.</summary>
    public void Dispose()
    {
        if (_disposed)
        {
            return;
        }

        _disposed = true;
        _pendingRequest?.TrySetCanceled();
        _pendingRequest = null;
    }
}
