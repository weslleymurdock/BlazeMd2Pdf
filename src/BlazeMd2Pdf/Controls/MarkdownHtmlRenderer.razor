@namespace BlazeMd2Pdf.Controls

@using Microsoft.JSInterop
@using MudBlazor

<div @ref="_host" class="blaze-markdown-html-source" style="position:absolute;left:-100000px;top:0;width:800px;visibility:hidden;pointer-events:none;">
    <MudMarkdown Value="@Markdown" />
</div>

@code {
    /// <summary>Provides JavaScript interop for reading the rendered MudMarkdown HTML.</summary>
    [Inject]
    private IJSRuntime JsRuntime { get; set; } = default!;

    /// <summary>References the host element containing the rendered MudMarkdown component.</summary>
    private ElementReference _host;

    /// <summary>Stores the Markdown value rendered by MudMarkdown.</summary>
    private string _markdown = string.Empty;

    /// <summary>Stores the pending HTML conversion request.</summary>
    private TaskCompletionSource<string>? _pendingRequest;

    /// <summary>Gets or sets the Markdown source rendered by the component.</summary>
    [Parameter]
    public string Markdown
    {
        get => _markdown;
        set
        {
            if (string.Equals(_markdown, value, StringComparison.Ordinal))
            {
                return;
            }

            _markdown = value;
            _pendingRequest?.TrySetCanceled();
        }
    }

    /// <summary>Extracts the HTML produced by the MudMarkdown component after rendering.</summary>
    /// <param name="markdown">The Markdown source to render.</param>
    /// <param name="cancellationToken">The cancellation token.</param>
    /// <returns>The rendered HTML contained by the component.</returns>
    public async Task<string> RenderHtmlAsync(string markdown, CancellationToken cancellationToken = default)
    {
        cancellationToken.ThrowIfCancellationRequested();
        _markdown = markdown;
        _pendingRequest?.TrySetCanceled();
        _pendingRequest = new TaskCompletionSource<string>(TaskCreationOptions.RunContinuationsAsynchronously);
        using var registration = cancellationToken.Register(() => _pendingRequest.TrySetCanceled(cancellationToken));
        await InvokeAsync(StateHasChanged);
        return await _pendingRequest.Task;
    }

    /// <summary>Reads the rendered component HTML after Blazor has applied the pending render.</summary>
    /// <param name="firstRender">Whether this is the first render.</param>
    /// <returns>A task representing the asynchronous operation.</returns>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_pendingRequest is null)
        {
            return;
        }

        var request = _pendingRequest;
        _pendingRequest = null;
        try
        {
            var html = await JsRuntime.InvokeAsync<string>("blazeMd2Pdf.getInnerHtml", _host);
            request.TrySetResult(html);
        }
        catch (Exception exception)
        {
            request.TrySetException(exception);
        }
    }
}
