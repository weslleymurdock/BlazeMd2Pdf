@namespace BlazeMd2Pdf.Controls

@using Microsoft.JSInterop
@using MudBlazor

<MudDialog Style="width: 80vw;max-width: 80vw !important;">
    <TitleContent>
        <MudText Typo="Typo.h6">Markdown preview</MudText>
    </TitleContent>
    <DialogContent>
        <MudPaper Class="pa-4">
            <MudMarkdown Value="@Markdown" />
        </MudPaper>
    </DialogContent>
    <DialogActions>
        <MudButton StartIcon="@Icons.Material.Outlined.Download" OnClick="DownloadAsync" StartIcon="@Icons.Material.Filled.Download">Download</MudButton>
        <MudButton StartIcon="@Icons.Material.Outlined.Close" OnClick="Cancel">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    /// <summary>
    /// Gets or sets the Markdown content to display and download.
    /// </summary>
    [Parameter]
    public string Markdown { get; set; } = string.Empty;

    /// <summary>
    /// Gets or sets the suggested Markdown file name.
    /// </summary>
    [Parameter]
    public string FileName { get; set; } = "converted.md";

    /// <summary>
    /// Gets the dialog instance supplied by MudBlazor.
    /// </summary>
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    /// <summary>
    /// Provides JavaScript interop for initiating a browser download.
    /// </summary>
    [Inject]
    private IJSRuntime JsRuntime { get; set; } = default!;

    /// <summary>
    /// Downloads the displayed Markdown as a UTF-8 text file.
    /// </summary>
    private async Task DownloadAsync()
    {
        await JsRuntime.InvokeVoidAsync("blazeMd2Pdf.downloadTextFile", FileName, Markdown);
    }

    /// <summary>
    /// Closes the dialog without returning a result.
    /// </summary>
    private void Cancel()
    {
        MudDialog.Cancel();
    }
}
