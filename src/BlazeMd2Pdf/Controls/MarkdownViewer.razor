@using BlazeMd2Pdf.Services.Abstract

@inject IConverterService ConverterService
@inject IDialogService DialogService

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Markdown preview</MudText>
    </TitleContent>
    <DialogContent>
        <MudMarkdown Value="@Markdown" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    /// <summary>
    /// Gets or sets the Markdown content to display.
    /// </summary>
    [Parameter]
    public string Markdown { get; set; } = string.Empty;

    private void Close() => DialogService.Close();
}
