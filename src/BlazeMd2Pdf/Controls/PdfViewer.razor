@inject IDialogService DialogService

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">PDF preview</MudText>
    </TitleContent>
    <DialogContent>
        <MudPaper Class="pa-4">
            <MudText Typo="Typo.body2">The converted PDF is ready for download.</MudText>
            <MudText Typo="Typo.caption">@FileName</MudText>
        </MudPaper>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    /// <summary>
    /// Gets or sets the name of the generated PDF file.
    /// </summary>
    [Parameter]
    public string FileName { get; set; } = "converted.pdf";

    private void Close() => DialogService.Close();
}
