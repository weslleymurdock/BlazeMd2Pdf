@namespace BlazeMd2Pdf.Pages

@page "/topdf"

@using BlazeMd2Pdf.Controls
@using BlazeMd2Pdf.Services.Abstract
@using Microsoft.AspNetCore.Components.Forms
@using MudBlazor

@implements IDisposable

@inject IConverterService ConverterService
@inject IDialogService DialogService

<PageTitle>Markdown to PDF</PageTitle>

<MudStack Class="pa-6" Spacing="4">
    <MudText Typo="Typo.h4">Markdown to PDF</MudText>
    <MudText Typo="Typo.body1">Select a Markdown file, configure the page like a word processor, and preview the generated PDF.</MudText>

    <MudPaper Class="pa-4" Elevation="1">
        <MudText Typo="Typo.h6">Document layout</MudText>
        <MudText Typo="Typo.body2" Class="mb-4">Margins define the printable area. Left and right margins are independent from top and bottom margins.</MudText>
        <MudStack Spacing="3">
            <MudSelect T="string" Label="Font" @bind-Value="_options.FontKey" Variant="Variant.Outlined">
                @foreach (var font in ConverterService.AvailableFonts)
                {
                    <MudSelectItem T="string" Value="@font.Key">@font.DisplayName</MudSelectItem>
                }
            </MudSelect>
            <MudStack Row="true" Spacing="3">
                <MudNumericField T="double" Label="Font size (pt)" @bind-Value="_options.FontSize" Min="8" Max="18" Step="0.5" Variant="Variant.Outlined" />
                <MudNumericField T="double" Label="Line spacing" @bind-Value="_options.LineSpacing" Min="1" Max="2.5" Step="0.05" Variant="Variant.Outlined" />
                <MudSelect T="DocumentTextAlignment" Label="Text alignment" @bind-Value="_options.Alignment" Variant="Variant.Outlined">
                    <MudSelectItem Value="DocumentTextAlignment.Left">Left</MudSelectItem>
                    <MudSelectItem Value="DocumentTextAlignment.Center">Center</MudSelectItem>
                    <MudSelectItem Value="DocumentTextAlignment.Right">Right</MudSelectItem>
                    <MudSelectItem Value="DocumentTextAlignment.Justify">Justify</MudSelectItem>
                </MudSelect>
            </MudStack>
            <MudText Typo="Typo.subtitle2">Page margins</MudText>
            <MudStack Row="true" Spacing="3">
                <MudNumericField T="double" Label="Left / right (mm)" @bind-Value="_options.HorizontalMargin" Min="5" Max="60" Step="1" Variant="Variant.Outlined" />
                <MudNumericField T="double" Label="Top (mm)" @bind-Value="_options.TopMargin" Min="5" Max="60" Step="1" Variant="Variant.Outlined" />
                <MudNumericField T="double" Label="Bottom (mm)" @bind-Value="_options.BottomMargin" Min="5" Max="60" Step="1" Variant="Variant.Outlined" />
            </MudStack>
            <MudText Typo="Typo.subtitle2">Paragraph spacing</MudText>
            <MudStack Row="true" Spacing="3">
                <MudNumericField T="double" Label="Paragraph after (pt)" @bind-Value="_options.ParagraphSpacing" Min="0" Max="24" Step="1" Variant="Variant.Outlined" />
                <MudNumericField T="double" Label="Heading spacing (pt)" @bind-Value="_options.HeadingSpacing" Min="0" Max="30" Step="1" Variant="Variant.Outlined" />
            </MudStack>
            <MudSwitch T="bool" @bind-Value="_options.KeepHeadingWithNext" Color="Color.Primary">
                Keep headings with following content when possible
            </MudSwitch>
        </MudStack>
    </MudPaper>

    <MudFileUpload T="IBrowserFile"
                   Accept=".md, .markdown"
                   MaximumFileCount="1"
                   MaxFileSize="@MaxFileSize"
                   Disabled="@_busy"
                   FilesChanged="OnFileSelected">
        <CustomContent>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@context.OpenFilePickerAsync" StartIcon="@Icons.Material.Filled.UploadFile">
                Select Markdown
            </MudButton>
        </CustomContent>
    </MudFileUpload>

    <MarkdownHtmlRenderer @ref="_markdownHtmlRenderer" />

    @if (_selectedFile is not null)
    {
        <MudText Typo="Typo.body2">Selected: @_selectedFile.Name</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@_busy" OnClick="ConvertSelectedFileAsync" StartIcon="@Icons.Material.Filled.PictureAsPdf">
            Generate PDF
        </MudButton>
    }

    @if (_fontSelectionRequired)
    {
        <MudAlert Severity="Severity.Warning">The selected font cannot represent a character in this document. Choose another font and generate the PDF again.</MudAlert>
    }
    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error">@_error</MudAlert>
    }
    @if (_busy)
    {
        <MudProgressLinear Indeterminate="true" />
    }
</MudStack>

@code {
    /// <summary>Gets the maximum accepted Markdown size in bytes.</summary>
    private const long MaxFileSize = 10 * 1024 * 1024;
    /// <summary>Indicates whether a conversion is currently running.</summary>
    private bool _busy;
    /// <summary>Contains the current user-facing error message.</summary>
    private string? _error;
    /// <summary>Indicates whether the user must choose another font.</summary>
    private bool _fontSelectionRequired;
    /// <summary>Stores the selected PDF presentation options.</summary>
    private PdfConversionOptions _options = new();
    /// <summary>Stores the currently selected browser file.</summary>
    private IBrowserFile? _selectedFile;
    /// <summary>References the MudMarkdown HTML renderer.</summary>
    private MarkdownHtmlRenderer? _markdownHtmlRenderer;
    /// <summary>Provides cancellation for the current conversion operation.</summary>
    private CancellationTokenSource _cancellationTokenSource = new();

    /// <summary>Processes the selected Markdown file without starting conversion automatically.</summary>
    /// <param name="file">The selected browser file.</param>
    private Task OnFileSelected(IBrowserFile? file)
    {
        _error = null;
        _fontSelectionRequired = false;
        _selectedFile = null;
        if (file is null)
        {
            return Task.CompletedTask;
        }

        var extension = Path.GetExtension(file.Name);
        if (!string.Equals(extension, ".md", StringComparison.OrdinalIgnoreCase) && !string.Equals(extension, ".markdown", StringComparison.OrdinalIgnoreCase))
        {
            _error = "Only Markdown files are supported.";
            return Task.CompletedTask;
        }

        _selectedFile = file;
        return Task.CompletedTask;
    }

    /// <summary>Converts the selected Markdown file using the configured PDF options.</summary>
    private async Task ConvertSelectedFileAsync()
    {
        var selectedFile = _selectedFile;
        var markdownHtmlRenderer = _markdownHtmlRenderer;
        if (selectedFile is null || markdownHtmlRenderer is null)
        {
            _error = "The Markdown renderer is not ready. Please try again.";
            return;
        }

        _cancellationTokenSource.Cancel();
        _cancellationTokenSource.Dispose();
        _cancellationTokenSource = new CancellationTokenSource();
        var cancellationToken = _cancellationTokenSource.Token;
        _busy = true;
        _error = null;
        _fontSelectionRequired = false;

        try
        {
            await using var stream = selectedFile.OpenReadStream(MaxFileSize, cancellationToken);
            var markdown = await ConverterService.ReadMarkdownAsync(stream, cancellationToken);
            var html = await markdownHtmlRenderer.RenderHtmlAsync(markdown, cancellationToken);
            if (string.IsNullOrWhiteSpace(html))
            {
                throw new InvalidOperationException("MudMarkdown produced an empty HTML document.");
            }

            var pdfBytes = await ConverterService.ConvertMarkdownToPdfAsync(html, _options, cancellationToken);
            var parameters = new DialogParameters
            {
                ["Content"] = pdfBytes,
                ["FileName"] = Path.ChangeExtension(selectedFile.Name, ".pdf")
            };
            await DialogService.ShowAsync<PdfViewer>("PDF preview", parameters);
        }
        catch (UnsupportedFontCharacterException exception)
        {
            _fontSelectionRequired = true;
            _error = exception.Message;
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            _error = exception.ToString();
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>Releases resources used to cancel the current conversion operation.</summary>
    public void Dispose()
    {
        _cancellationTokenSource.Cancel();
        _cancellationTokenSource.Dispose();
    }
}
