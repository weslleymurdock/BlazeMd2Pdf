@namespace BlazeMd2Pdf.Pages

@page "/topdf"

@using BlazeMd2Pdf.Controls
@using BlazeMd2Pdf.Services.Abstract
@using Microsoft.AspNetCore.Components.Forms
@using MudBlazor

@implements IDisposable

@inject IConverterService ConverterService
@inject IDialogService DialogService

<PageTitle>Markdown to PDF</PageTitle>

<MudStack Class="pa-6" Spacing="4">
    <MudText Typo="Typo.h4">Markdown to PDF</MudText>
    <MudText Typo="Typo.body1">Select a Markdown file to generate a PDF.</MudText>

    <MudFileUpload T="IBrowserFile"
                   Accept=".md, .markdown"
                   MaximumFileCount="1"
                   MaxFileSize="@MaxFileSize"
                   Disabled="@_busy"
                   FilesChanged="OnFileSelected">
        <CustomContent>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       OnClick="@context.OpenFilePickerAsync"
                       StartIcon="@Icons.Material.Filled.UploadFile">
                Select Markdown
            </MudButton>
        </CustomContent>
    </MudFileUpload>

    @if (_fontSelectionRequired)
    {
        <MudAlert Severity="Severity.Warning">
            The selected font cannot represent a character in this document. Choose another document font and try again.
        </MudAlert>

        <MudSelect T="string" Label="Document font" @bind-Value="_selectedFont">
            @foreach (var font in ConverterService.AvailableFonts)
            {
                <MudSelectItem T="string" Value="@font.Key">@font.DisplayName</MudSelectItem>
            }
        </MudSelect>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Disabled="@_busy"
                   OnClick="ConvertSelectedFileAsync"
                   StartIcon="@Icons.Material.Filled.PictureAsPdf">
            Try selected font
        </MudButton>
    }

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error">@_error</MudAlert>
    }

    @if (_busy)
    {
        <MudProgressLinear Indeterminate="true" />
    }
</MudStack>

@code {
    /// <summary>
    /// Gets the maximum accepted Markdown size in bytes.
    /// </summary>
    private const long MaxFileSize = 10 * 1024 * 1024;

    /// <summary>
    /// Indicates whether a conversion is currently running.
    /// </summary>
    private bool _busy;

    /// <summary>
    /// Contains the current user-facing error message.
    /// </summary>
    private string? _error;

    /// <summary>
    /// Indicates whether the user must choose another font.
    /// </summary>
    private bool _fontSelectionRequired;

    /// <summary>
    /// Stores the selected document font.
    /// </summary>
    private string _selectedFont = "liberation-sans";

    /// <summary>
    /// Stores the currently selected browser file.
    /// </summary>
    private IBrowserFile? _selectedFile;

    /// <summary>
    /// Provides cancellation for the current conversion operation.
    /// </summary>
    private CancellationTokenSource _cancellationTokenSource = new();

    /// <summary>
    /// Processes the selected Markdown file.
    /// </summary>
    /// <param name="file">The selected browser file.</param>
    private async Task OnFileSelected(IBrowserFile? file)
    {
        _error = null;
        _fontSelectionRequired = false;
        _selectedFile = null;

        if (file is null)
        {
            return;
        }

        var extension = Path.GetExtension(file.Name);
        if (!string.Equals(extension, ".md", StringComparison.OrdinalIgnoreCase) &&
            !string.Equals(extension, ".markdown", StringComparison.OrdinalIgnoreCase))
        {
            _error = "Only Markdown files are supported.";
            return;
        }

        _selectedFile = file;
        await ConvertSelectedFileAsync();
    }

    /// <summary>
    /// Converts the selected Markdown file using the currently selected document font.
    /// </summary>
    private async Task ConvertSelectedFileAsync()
    {
        var selectedFile = _selectedFile;
        if (selectedFile is null)
        {
            return;
        }

        _cancellationTokenSource.Cancel();
        _cancellationTokenSource.Dispose();
        _cancellationTokenSource = new CancellationTokenSource();
        var cancellationToken = _cancellationTokenSource.Token;

        _busy = true;
        _error = null;

        try
        {
            await using var stream = selectedFile.OpenReadStream(MaxFileSize, cancellationToken);
            var markdown = await ConverterService.ReadMarkdownAsync(stream, cancellationToken);
            var pdfBytes = await ConverterService.ConvertMarkdownToPdfAsync(markdown, _selectedFont, cancellationToken);

            _fontSelectionRequired = false;
            await DialogService.ShowAsync<PdfViewer>(
                "PDF preview",
                new DialogParameters<PdfViewer>
                {
                    { viewer => viewer.Content, pdfBytes },
                    { viewer => viewer.FileName, Path.ChangeExtension(selectedFile.Name, ".pdf") }
                });
        }
        catch (UnsupportedFontCharacterException exception)
        {
            _fontSelectionRequired = true;
            _error = exception.Message;
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>
    /// Releases resources used to cancel the current conversion operation.
    /// </summary>
    public void Dispose()
    {
        _cancellationTokenSource.Cancel();
        _cancellationTokenSource.Dispose();
    }
}
